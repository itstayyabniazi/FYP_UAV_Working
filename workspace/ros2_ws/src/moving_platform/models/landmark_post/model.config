<?xml version="1.0"?>
<model>
  <name>landmark_post</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>zanan</name>
  </author>

  <description>
    Static, brightly-coloured reference post -- purely visual, no physics/plugins.
    Spawn a few of these around the world (e.g. at the patrol square's corners) so
    the moving_platform's motion (linear or circular) is visible against something
    other than the bare ground plane. Safe to spawn anywhere outside the platform's
    own path -- it has real collision geometry, so don't place one where the UAV or
    the platform will actually fly/drive through it.
  </description>
</model>
