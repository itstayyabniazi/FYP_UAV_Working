<?xml version="1.0"?>
<model>
  <name>moving_platform</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>zanan</name>
  </author>

  <description>
    Flat landing-pad platform for the RL landing task. Kinematically driven by
    a Twist command on /model/moving_platform/cmd_vel (gz-sim VelocityControl
    system) -- see ros2_ws/src/moving_platform/moving_platform/moving_platform_node.py,
    which computes the commanded velocity (and the ground-truth PlatformState
    published to the RL pipeline) from an analytic circular trajectory.
  </description>
</model>
