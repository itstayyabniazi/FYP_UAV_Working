<?xml version="1.0"?>
<sdf version="1.9">
  <model name="moving_platform">
    <!-- Not static: VelocityControl needs a free body to apply velocity to.
         It sets this link's linear/angular velocity directly every step
         (kinematically), so gravity never gets a chance to accumulate as
         long as cmd_vel keeps being published (see moving_platform_node.py). -->
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>9.386</ixx>
          <iyy>9.386</iyy>
          <izz>18.75</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.05</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>1.5 1.5 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.6 0.1 1</ambient>
          <diffuse>0.9 0.6 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Red cross border around the ArUco marker below: purely visual
           (real-world-style landing-pad marking), detection is untouched.
           aruco_landing_target_node.py only ever looks for the actual
           ArUco bit-pattern in the center, which is still the exact same
           0.5x0.5 textured square it always was. Two overlapping bars
           forming a "+", sitting UNDER the marker square (z=0.026, same
           height the marker used to be at) so the marker (moved up to
           z=0.027) renders on top without z-fighting. -->
      <visual name="cross_arm_horizontal">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry>
          <box>
            <size>1.0 0.25 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0 0 1</ambient>
          <diffuse>0.8 0 0 1</diffuse>
        </material>
      </visual>

      <visual name="cross_arm_vertical">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 1.0 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0 0 1</ambient>
          <diffuse>0.8 0 0 1</diffuse>
        </material>
      </visual>

      <!-- ArUco landing target for the vision pipeline (vision_node package).
           Generated by ../scripts/generate_aruco_marker.py (DICT_4X4_50, id 0;
           keep in sync with aruco_landing_target_node.py's ARUCO_DICT and
           MARKER_ID). Sits flush on the platform's top face (base_link's box
           is 1.5x1.5x0.05, centered at the link origin, so its top face is at
           local z=0.025); z=0.027 clears both that and the cross arms above
           to avoid z-fighting. roughness/metalness keep it looking like a
           flat printed decal rather than a shiny/metallic surface, which
           matters for reliable detection under Gazebo's default lighting. -->
      <visual name="aruco_marker">
        <pose>0 0 0.027 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <!-- ambient/diffuse must be set to white here even though the
               actual pattern comes from albedo_map below: gz-sim's PBR
               pipeline blends the albedo texture against this base color,
               which defaults to black when omitted, silently multiplying
               the entire texture down to solid black regardless of what
               the image contains (confirmed: file installs and resolves
               correctly, no resource-path errors, still rendered as a
               plain black rectangle until this was added). -->
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://moving_platform/materials/textures/aruco_marker.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
    </plugin>
  </model>
</sdf>
