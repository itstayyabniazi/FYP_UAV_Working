{"nodes": [{"id": "workspace_ros2_ws_src_vision_node_readme", "label": "vision_node README", "file_type": "document", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_ros2_ws_src_vision_node_readme_aruco_landing_target_node", "label": "aruco_landing_target_node (ArUco DICT_4X4_50 id 0 detector)", "file_type": "code", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_ros2_ws_src_vision_node_readme_camera_latency", "label": "Camera latency compensation (camera_latency 0.35 s default, 0.09 s measured)", "file_type": "rationale", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marker world position is UAV position + measurement, so it must use the UAV pose at capture time; otherwise latency x UAV velocity looks like platform motion and the lock never settles."}, {"id": "workspace_ros2_ws_src_vision_node_readme_measure_camera_latency", "label": "measure_camera_latency.py", "file_type": "code", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_ros2_ws_src_vision_node_readme_mission_states", "label": "Mission states PATROL / TRACK / LAND / RECOVER", "file_type": "concept", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_ros2_ws_src_vision_node_readme_camera_to_body", "label": "CAMERA_TO_BODY frame convention", "file_type": "concept", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": nu