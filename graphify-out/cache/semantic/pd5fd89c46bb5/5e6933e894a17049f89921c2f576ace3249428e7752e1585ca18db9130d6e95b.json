25% offline at slight cost to sharp-turn reaction."}, {"id": "workspace_ros2_ws_src_vision_node_readme_telemetry_stalled_crash", "label": "TELEMETRY_STALLED crash (tracker ~3 m/s velocity estimate)", "file_type": "concept", "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "workspace_ros2_ws_src_vision_node_readme", "target": "workspace_ros2_ws_src_vision_node_readme_aruco_landing_target_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_ros2_ws_src_vision_node_readme_mission_states", "target": "workspace_ros2_ws_src_vision_node_readme_aruco_landing_target_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_ros2_ws_src_vision_node_readme_mission_states", "target": "claude_vision_landing_py", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_ros2_ws_src_vision_node_readme_camera_latency", "target": "workspace_ros2_ws_src_vision_node_readme_measure_camera_latency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_ros2_ws_src_vision_node_readme_camera_latency", "target": "claude_moving_landing_py", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "workspace/ros2_ws/src/vision_node/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_ros2_ws_src_vision_no