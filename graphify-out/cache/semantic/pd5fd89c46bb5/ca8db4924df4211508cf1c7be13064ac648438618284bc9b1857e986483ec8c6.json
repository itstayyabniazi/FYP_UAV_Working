{"nodes": [{"id": "workspace_uav_rl_landing_prediction_readme", "label": "prediction/ README (LSTM-MDN predictor)", "file_type": "document", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_lstm_mdn", "label": "LSTM-MDN predictor (mixture of K=5 bivariate Gaussians)", "file_type": "concept", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mixture can say '50% keeps going, 25% turns left, 25% right', which one Gaussian or a line cannot."}, {"id": "workspace_uav_rl_landing_prediction_readme_features_py", "label": "features.py (detections -> network input, ENU)", "file_type": "code", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_datagen_py", "label": "datagen.py (synthetic tracks: train/val/heldout)", "file_type": "code", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_train_py", "label": "train.py (torch, exports mdn_v2.npz)", "file_type": "code", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_mdn_numpy_py", "label": "mdn_numpy.py (pure-numpy mission inference)", "file_type": "code", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_evaluate_py", "label": "evaluate.py (MDN vs CV vs tracker CTRV)", "file_type": "code", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_mdn_point_peak", "label": "--mdn-point peak (densest mixture point)", "file_type": "rationale", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixture mean sits in the empty middle on back-and-forth (linear 5 km/h 0/18 within 0.45 m); top mode weaker on random paths; peak never lost to the tracker."}, {"id": "workspace_uav_rl_landing_prediction_readme_mdn_gate", "label": "--mdn-gate uncertainty descent gate (negative result)", "file_type": "rationale", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spread is mostly set by platform speed (correlation 0.83) because turn start time is random, so pausing did not help and cost 10-15 s."}, {"id": "workspace_uav_rl_landing_prediction_readme_real_gazebo_ab", "label": "Real Gazebo A/B so far: MDN no benefit yet", "file_type": "concept", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workspace_uav_rl_landing_prediction_readme_overconfidence", "label": "Over-confidence outside training ranges / domain gap", "file_type": "rationale", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held-out coverage 5%/56% vs target 50%/90%; training data come from our own generator so real-car motion is untested."}, {"id": "workspace_uav_rl_landing_prediction_readme_fixed_camera_tilt", "label": "Fixed-camera tilt makes marker leave image at 17-26 deg (lock-on is dominant problem)", "file_type": "rationale", "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 m x tan(24 deg) = 2.2 m about the whole 2.25 m half-FOV; detector is already tilt-corrected so the marker physically leaves the image; fake world has no attitude."}], "edges": [{"source": "workspace_uav_rl_landing_prediction_readme", "target": "workspace_uav_rl_landing_prediction_readme_lstm_mdn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_uav_rl_landing_prediction_readme_features_py", "target": "workspace_uav_rl_landing_prediction_readme_lstm_mdn", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_uav_rl_landing_prediction_readme_datagen_py", "target": "workspace_uav_rl_landing_prediction_readme_train_py", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_uav_rl_landing_prediction_readme_train_py", "target": "workspace_uav_rl_landing_prediction_readme_lstm_mdn", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "workspace/uav_rl_landing/prediction/README.md", "source_location": null, "weight": 1.0}, {"source": "workspace_uav_rl_landing_prediction_readme_train_py", "target": "workspace_uav_rl_landing_prediction_readme_mdn_numpy_py", "relation": "shar