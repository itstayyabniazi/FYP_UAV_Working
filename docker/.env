# ======================================================
# FYP UAV Docker Environment
# ======================================================

USERNAME=zanan
UID=1000
GID=1002

# GPU render-device group GID, used by docker-compose.yml's group_add so the
# container can actually open /dev/dri/renderD128 for Gazebo's camera
# rendering. Host-specific -- check with `stat -c '%g' /dev/dri/renderD128`
# on whichever machine you're building on, and update this value to match.
# (992 on the original Parrot laptop; 990 on the Ubuntu lab PC.)
RENDER_GID=992
