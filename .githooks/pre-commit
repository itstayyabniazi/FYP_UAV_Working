#!/bin/sh
# Keeps the Graphify knowledge graph (graphify-out/) in sync with the code:
# rebuilds the code graph and stages it so it lands in the SAME commit.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Requires:                graphify CLI (pipx install graphifyy)
# Skip for one commit:     GRAPHIFY_SKIP_HOOK=1 git commit ...
#
# Code only (AST, no LLM, ~2s). After editing docs/config (README, yaml, ...),
# refresh those nodes manually with `/graphify . --update` in Claude Code.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

# Don't interfere with rebase / merge / cherry-pick.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

# Nothing to do if the commit only touches graphify-out/ itself.
git diff --cached --name-only | grep -qv '^graphify-out/' || exit 0

GRAPHIFY=$(command -v graphify 2>/dev/null)
[ -z "$GRAPHIFY" ] && [ -x "$HOME/.local/bin/graphify" ] && GRAPHIFY="$HOME/.local/bin/graphify"
if [ -z "$GRAPHIFY" ]; then
    echo "[graphify hook] graphify not found - skipping graph update (pipx install graphifyy)" >&2
    exit 0
fi

# Pinned so community assignments are reproducible run-to-run (no diff noise).
export PYTHONHASHSEED=0

if "$GRAPHIFY" update . >/dev/null 2>&1; then
    git add graphify-out
    echo "[graphify hook] graph updated and staged"
else
    # A broken graph tool must never block a commit.
    echo "[graphify hook] graph update failed - committing without it (run: graphify update .)" >&2
fi
exit 0
